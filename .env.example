# ── Face → Web → Blockchain — free setup (no paid services) ─────
# 1) SerpApi (Google Lens) — 100 free searches/month, no card
#    Sign up: https://serpapi.com/users/sign_up
#    Dashboard → API Key → paste below
SERPAPI_KEY=

# 2) Polygon Amoy — free testnet, no cost
#    Public RPC (no key needed):
POLYGON_RPC_URL=https://polygon-amoy.drpc.org
#    Fallbacks tried automatically:
#    https://polygon-amoy.drpc.org
#    https://polygon-amoy-bor-rpc.publicnode.com

#    Deployer key — create a fresh wallet, fund with free faucet:
#    Faucet: https://faucet.polygon.technology/  (select Amoy)
#    Export private key from MetaMask → Account details → Show private key
#    Format: 0x... (never commit this file)
PRIVATE_KEY=

#    Filled after deploy:
#    python scripts/deploy.py
CONTRACT_ADDRESS=

